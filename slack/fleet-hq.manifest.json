{
  "display_information": {
    "name": "Fleet HQ",
    "description": "The control room of the agent fleet. Status, approvals, the board, and the kill switch.",
    "background_color": "#1c1b22"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "Fleet HQ",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/fleet",
        "description": "Control the agent fleet",
        "usage_hint": "status | pause | resume | stop | brief | board | approvals | ask AGENT TEXT | run WORKFLOW | tokens | help",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.customize",
        "commands",
        "channels:read",
        "channels:manage",
        "channels:join",
        "pins:write",
        "bookmarks:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_home_opened"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
