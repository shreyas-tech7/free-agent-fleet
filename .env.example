# agent-fleet secret names. Placeholders only.
#
# Do not put real values in this file. Do not copy it to a real .env file.
# Run `fleetctl secret set NAME` for each key. That command writes the value to the
# one secret file that the right service reads, with mode 600.
# The list comes from config/secrets.yaml.

# ---- router: Model providers for the router (free plans only) ----
# Groq free plan API key. Get it at: https://console.groq.com/keys
GROQ_API_KEY=REPLACE_ME
# Cloudflare Workers AI token, scope Workers AI read and run only. Get it at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_AI_API_TOKEN=REPLACE_ME
# Cloudflare account ID for Workers AI (an identifier, kept with the token). Get it at: https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME
# OpenRouter key. Use free models (names end in :free) only. Get it at: https://openrouter.ai/keys
OPENROUTER_API_KEY=REPLACE_ME
# Google AI Studio key, free plan. Get it at: https://aistudio.google.com/apikey
GEMINI_API_KEY=REPLACE_ME
# Cohere trial API key. Non-commercial. 20 requests per minute and 1000 calls per month. Get it at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=REPLACE_ME
# NVIDIA build.nvidia.com trial key. For evaluation and prototyping only. Get it at: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=REPLACE_ME
# LLM7 token. Free turbo models only. See D-069. Get it at: https://dash.llm7.io/
LLM7_API_KEY=REPLACE_ME
# Aion Labs key. Free grant only, no card. See D-069. Get it at: https://aionlabs.ai
AION_API_KEY=REPLACE_ME

# ---- publisher: Social accounts and channels. Only the Publisher reads them. ----
# Bluesky app password. Never use the main password. Get it at: https://bsky.app/settings/app-passwords
BLUESKY_APP_PASSWORD=REPLACE_ME
# Mastodon access token with scopes write:statuses and write:accounts. Get it at: your Mastodon instance, Preferences, Development
MASTODON_ACCESS_TOKEN=REPLACE_ME
# Bot token for the fleet's own Discord server. Get it at: https://discord.com/developers/applications
DISCORD_PUBLISHER_BOT_TOKEN=REPLACE_ME
# Bot token that posts to the fleet's Telegram channel. Get it at: https://t.me/BotFather
TELEGRAM_PUBLISHER_BOT_TOKEN=REPLACE_ME
# dev.to (Forem) API key. Get it at: https://dev.to/settings/extensions
DEVTO_API_KEY=REPLACE_ME
# GitHub fine-grained token for releases and discussions of the product repositories. Get it at: https://github.com/settings/personal-access-tokens
GITHUB_PUBLISHER_TOKEN=REPLACE_ME
# X user access token. The X adapter stays off until X API access exists. Get it at: https://developer.x.com
X_ACCESS_TOKEN=REPLACE_ME
# Reddit app secret. The Reddit adapter stays off until Reddit API access exists. Get it at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_SECRET=REPLACE_ME

# ---- deployer: Cloudflare token. Only the Deployer reads it. ----
# Cloudflare token for Workers, Pages, and D1 on the free plan. Get it at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=REPLACE_ME
# Cloudflare account ID (an identifier, kept with the token). Get it at: https://dash.cloudflare.com
CLOUDFLARE_DEPLOYER_ACCOUNT_ID=REPLACE_ME

# ---- control: Control bot tokens for Telegram and Discord ----
# Telegram bot token for the control bot and the daily brief. Get it at: https://t.me/BotFather
CONTROL_TELEGRAM_BOT_TOKEN=REPLACE_ME
# Discord bot token for the control bot and the daily brief. Get it at: https://discord.com/developers/applications
CONTROL_DISCORD_BOT_TOKEN=REPLACE_ME

# ---- slack: Slack app tokens: Fleet HQ (the control bot) and Hermes (the orchestrator) ----
# Bot token of the Fleet HQ Slack app. The control bot posts and answers with it. Get it at: https://api.slack.com/apps
SLACK_HQ_BOT_TOKEN=REPLACE_ME
# App-level token of the Fleet HQ Slack app. It opens the Socket Mode connection. Only one process may use it. Get it at: https://api.slack.com/apps
SLACK_HQ_APP_TOKEN=REPLACE_ME
# Bot token of the Hermes Slack app. The orchestrator profile talks to you with it. Get it at: https://api.slack.com/apps
SLACK_HERMES_BOT_TOKEN=REPLACE_ME
# App-level token of the Hermes Slack app. It opens the Socket Mode connection. Only one process may use it. Get it at: https://api.slack.com/apps
SLACK_HERMES_APP_TOKEN=REPLACE_ME

# ---- briefing: SMTP login for the daily brief ----
# SMTP password or app password for the daily brief email. Get it at: your mail provider
SMTP_PASSWORD=REPLACE_ME

# ---- backup: GitHub token that lets the nightly backup push the repository ----
# GitHub token that pushes the repository (no secrets in it) after each backup. Get it at: https://github.com/settings/personal-access-tokens
BACKUP_GITHUB_TOKEN=REPLACE_ME

# ---- internal: Keys that the installer makes. The owner never types them. ----
# OmniRoute session signing secret. Get it at: made by the installer
JWT_SECRET=REPLACE_ME
# OmniRoute secret that encrypts the stored provider keys. Get it at: made by the installer
API_KEY_SECRET=REPLACE_ME
# OmniRoute key that encrypts its database at rest. Get it at: made by the installer
STORAGE_ENCRYPTION_KEY=REPLACE_ME
# OmniRoute management password. The router and the quota tracker read it. It is in its own file so the quota tracker never sees a provider key. Get it at: made by the installer
INITIAL_PASSWORD=REPLACE_ME
# SearXNG instance secret. Get it at: made by the installer
SEARXNG_SECRET=REPLACE_ME
# Local token that the briefing presents to the control bot to reach the owner. Get it at: made by the installer
CONTROL_NOTIFY_TOKEN=REPLACE_ME
# Local key that Hermes presents to the router on 127.0.0.1. Get it at: made by the installer
ROUTER_KEY_HERMES=REPLACE_ME
# Local key that the briefing presents to the router. Get it at: made by the installer
ROUTER_KEY_BRIEFING=REPLACE_ME
# Local key for tests only. It can call only fleet-dev, which holds the trial models. No fleet service reads it. Get it at: made by the installer
ROUTER_KEY_DEV=REPLACE_ME
# n8n encrypts the credentials that it stores with this key. A new key makes every stored credential unreadable. Get it at: made by the installer
N8N_ENCRYPTION_KEY=REPLACE_ME
# bcrypt hash of the n8n owner password. n8n makes the owner account from it at each start. Get it at: made from N8N_OWNER_PASSWORD by fleetctl n8n prepare
N8N_INSTANCE_OWNER_PASSWORD_HASH=REPLACE_ME
# Password of the n8n owner account. Only root and fleetctl read it. The owner reads it with: sudo fleetctl secret show N8N_OWNER_PASSWORD. Get it at: made by the installer
N8N_OWNER_PASSWORD=REPLACE_ME
# n8n public API key with the smallest scopes that fleetctl needs. fleetctl and the n8n-mcp helper for Claude Code read it. Get it at: made by fleetctl n8n bootstrap through the n8n login
N8N_API_KEY=REPLACE_ME
# Header token that the event relay sends to the n8n webhook fleet-event. n8n holds the same value as a credential. Get it at: made by the installer
FLEET_EVENT_TOKEN=REPLACE_ME
# Bearer token that n8n presents to the fleet action API of the control bot. The control bot holds only its hash. Get it at: made by the installer
FLEET_ACTION_TOKEN=REPLACE_ME
# Bearer token that the Hermes agents present to the fleet-tools MCP server in n8n. Each agent sees only its own tools. Get it at: made by the installer
N8N_TOOLS_TOKEN=REPLACE_ME
# Local token that the marketing agent presents to the Publisher. Get it at: made by the installer
PUBLISHER_API_TOKEN=REPLACE_ME
# Local token that the feedback agent presents to the Publisher. It can send only approved FAQ answers. Get it at: made by the installer
PUBLISHER_REPLY_TOKEN=REPLACE_ME
# Local token that the build agent presents to the Deployer. Get it at: made by the installer
DEPLOYER_API_TOKEN=REPLACE_ME
