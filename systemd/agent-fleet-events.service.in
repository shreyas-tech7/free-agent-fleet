[Unit]
Description=agent-fleet event relay (sends fleet events from the spool to n8n)
Documentation=file:///opt/agent-fleet/repo/docs/N8N.md
After=network-online.target
Wants=network-online.target
PartOf=agent-fleet.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=fleetops
Group=fleetops
WorkingDirectory=@REPO@
Environment=PYTHONPATH=@REPO@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HERMES_MANAGED_DIR=/etc/hermes
ExecStart=/usr/bin/python3 -m ops.events.relay
Restart=always
RestartSec=5
MemoryMax=100M
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/agent-fleet-ops
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
TemporaryFileSystem=/etc/agent-fleet/secrets:ro
BindReadOnlyPaths=/etc/agent-fleet/secrets/events.env

[Install]
WantedBy=agent-fleet.target
