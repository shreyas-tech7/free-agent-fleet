[Unit]
Description=agent-fleet card ingester (makes Kanban cards from checked requests)
Documentation=file:///opt/agent-fleet/repo/docs/N8N.md
After=agent-fleet-guard.service agent-fleet-gateway.service

[Service]
Type=oneshot
User=fleet
Group=fleet
WorkingDirectory=@REPO@
Environment=PYTHONPATH=@REPO@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/home/fleet
Environment=HERMES_MANAGED_DIR=/etc/hermes
Environment=PATH=/home/fleet/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m ops.cards.ingest
# One run in 15 seconds at most. A request that cannot go through waits for the next run.
ExecStartPost=/usr/bin/sleep 15
TimeoutStartSec=300
MemoryMax=300M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
