[Unit]
Description=agent-fleet page reader (safe fetch, Crawl4AI conversion, injection scan)
Documentation=file:///opt/agent-fleet/repo/docs/SECURITY.md
After=network-online.target agent-fleet-guard.service
Wants=network-online.target
PartOf=agent-fleet.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=fleetops
Group=fleetops
WorkingDirectory=@REPO@
Environment=PYTHONPATH=@REPO@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/agent-fleet-ops/reader
Environment=CRAWL4_AI_BASE_DIRECTORY=/var/lib/agent-fleet-ops/reader
Environment=HERMES_MANAGED_DIR=/etc/hermes
ExecStart=/opt/agent-fleet/venvs/reader/bin/python -m ops.reader.server
Restart=on-failure
RestartSec=5
MemoryMax=1G
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/agent-fleet-ops/reader
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
InaccessiblePaths=/etc/agent-fleet/secrets

[Install]
WantedBy=agent-fleet.target
