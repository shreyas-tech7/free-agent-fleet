[Unit]
Description=agent-fleet n8n release and advisory check (plain code, no model, never upgrades)
Documentation=file:///opt/agent-fleet/repo/docs/N8N.md
After=network-online.target
Wants=network-online.target
PartOf=agent-fleet.target

[Service]
Type=oneshot
User=fleetops
Group=fleetops
WorkingDirectory=@REPO@
Environment=PYTHONPATH=@REPO@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HERMES_MANAGED_DIR=/etc/hermes
ExecStart=/usr/bin/python3 -m ops.n8n.watch releases
TimeoutStartSec=120
MemoryMax=150M
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/agent-fleet-ops
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
# No secret is mounted. The check reads only public GitHub data.
TemporaryFileSystem=/etc/agent-fleet/secrets:ro
