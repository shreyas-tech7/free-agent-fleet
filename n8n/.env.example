# n8n settings for docker-compose.yml. Copy this file to .env and fill it in. The real .env has mode 600 and stays out of git.
# On the fleet machine, the installer writes /var/lib/agent-fleet-ops/n8n/.env for you.
# This file holds no secret. The encryption key and the owner password hash go in secrets.env (mode 600).

# The image is pinned by version and by digest. Change it only with: fleetctl n8n upgrade VERSION
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.47.4@sha256:56a3f0d56c2888b53ca7d89de4aa3de702888f33667c96a1f1d7118548f979e9
N8N_VERSION=2.47.4

# Memory limit of the container. Size it for the machine. 1g fits a machine with 8 GB of RAM.
N8N_MEMORY=1g
N8N_MEMORY_SWAP=1536m

# Time zone for schedules.
N8N_TIMEZONE=America/Chicago

# The owner account is made from these values at the first start. The password hash is in secrets.env.
N8N_OWNER_EMAIL=owner@example.com
N8N_OWNER_FIRST_NAME=Owner
N8N_OWNER_LAST_NAME=Account

# Owner access over Tailscale (optional). Leave empty to use an SSH tunnel.
# Set both to the HTTPS address that `tailscale serve` prints, and set N8N_PROXY_HOPS=1.
N8N_EDITOR_BASE_URL=
WEBHOOK_URL=
N8N_PROXY_HOPS=0

# Where the secrets file is. The default is secrets.env next to this file.
N8N_SECRETS_FILE=./secrets.env
