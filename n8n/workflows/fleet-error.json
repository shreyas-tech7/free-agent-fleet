        "jsCode": "const e = $input.first().json;\nconst wf = (e.workflow && e.workflow.name) || 'an unknown workflow';\nconst node = (e.execution && e.execution.lastNodeExecuted) || '';\nconst msg = String((e.execution && e.execution.error && e.execution.error.message) || 'no message').replace(/\\s+/g, ' ').slice(0, 200);\nconst id = (e.execution && e.execution.id) || '';\nconst text = ('n8n workflow failed: ' + wf + (node ? ' at ' + node : '') + '. ' + msg + (id ? ' (run ' + id + ')' : '')).slice(0, 600);\nreturn [{ json: { text, run: String(id).replace(/[^A-Za-z0-9_-]/g, '').slice(0, 40) } }];\n"
