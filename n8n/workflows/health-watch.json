      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\ndata.fail = data.fail || {};\ndata.alerted = data.alerted || {};\nconst targets = $('Targets').all();\nconst checks = $('Check').all();\nconst status = $('Fleet Status').first().json || {};\nconst results = checks.map((c, i) => {\n  const code = Number(c.json.statusCode || 0);\n  return { name: targets[i].json.name, ok: !c.json.error && code >= 200 && code < 300, code };\n});\n// Units without an HTTP health path: the control bot reports their state.\nconst services = status.services || {};\nfor (const unit of ['gateway', 'events']) {\n  if (unit in services) results.push({ name: unit, ok: services[unit] === 'active', code: 0 });\n}\nif (!status.services) results.push({ name: 'control-api', ok: false, code: 0 });\nconst events = [];\nfor (const r of results) {\n  if (r.ok) {\n    if (data.alerted[r.name]) {\n      events.push({ type: 'health.recovered', severity: 'info', source: 'health-watch', title: r.name + ' is back', text: r.name + ' answers again.' });\n    }\n    data.fail[r.name] = 0;\n    data.alerted[r.name] = false;\n  } else {\n    data.fail[r.name] = (data.fail[r.name] || 0) + 1;\n    if (data.fail[r.name] >= 2 && !data.alerted[r.name]) {\n      data.alerted[r.name] = true;\n      events.push({ type: 'alert.health', severity: 'critical', source: 'health-watch', title: r.name + ' is down',\n                    text: r.name + ' failed 2 checks in a row' + (r.code ? ' (status ' + r.code + ')' : '') + '.', fields: { service: r.name } });\n    }\n  }\n}\nreturn events.map(e => ({ json: e }));\n"
      }
    },
